# Agent router: OpenAI-shaped in, OpenAI-shaped out, local llama as the floor.
# No model weights and no translation layer, so it costs almost nothing to run.
FROM python:3.11-slim

# tzdata so TZ works: this container names every exchange log by local
# time, and UTC logs beside the bridge's local ones are an hour apart.
RUN apt-get update \
 && apt-get install -y --no-install-recommends tzdata \
 && rm -rf /var/lib/apt/lists/*

RUN pip install --no-cache-dir aiohttp

COPY remote_proxy.py /app/remote_proxy.py
# Nova's character. Extracted from index.html rather than retyped, and asserted
# identical to the browser's copy by test_nova.py.
COPY persona.py /app/persona.py
# The reminder time grammar, shared with the bridge so the web and
# Telegram agree on what "at half seven" means.
COPY timeparse.py /app/timeparse.py
# Sums, answered by arithmetic instead of by the model.
COPY arith.py /app/arith.py
WORKDIR /app

ENV LOCAL_URL=http://llama:8080/v1/chat/completions \
    KEY_DIR=/run/keys \
    LOG_DIR=/logs

EXPOSE 5003
CMD ["python", "remote_proxy.py"]
