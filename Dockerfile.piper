# Piper neural TTS, HIGH-quality tier.
#
# The medium-tier voices this replaced sounded artifacty. Kokoro-82M was
# measured on this box first and rejected: RTF 2.8-3.0 against Piper's 0.13,
# i.e. ~12 s of compute for a 4 s sentence. Better model, wrong hardware.
#
# libritts_r is a multi-speaker model — one file, hundreds of speakers,
# selectable per request. It is the cheapest way to hunt for a voice you
# actually like without another rebuild.
FROM python:3.11-slim

RUN apt-get update \
 && apt-get install -y --no-install-recommends curl ca-certificates \
 && pip install --no-cache-dir piper-tts flask \
 && rm -rf /var/lib/apt/lists/*

ARG HF=https://huggingface.co/rhasspy/piper-voices/resolve/main/en

RUN mkdir -p /models && cd /models \
 && for v in \
      "en_US/ljspeech/high:en_US-ljspeech-high" \
      "en_US/lessac/high:en_US-lessac-high" \
      "en_GB/cori/high:en_GB-cori-high" \
      "en_US/libritts_r/medium:en_US-libritts_r-medium" \
    ; do \
      p="${v%%:*}"; n="${v##*:}"; \
      curl -fsSL -o "/models/$n.onnx"      "$HF/$p/$n.onnx"; \
      curl -fsSL -o "/models/$n.onnx.json" "$HF/$p/$n.onnx.json"; \
    done \
 && ls -lh /models

RUN apt-get purge -y --auto-remove curl && rm -rf /var/lib/apt/lists/*

ENV VOICE_MODEL=/models/en_US-ljspeech-high.onnx

# Neutral prosody settings. The previous build tightened these to sound
# synthetic; that compounded with the medium-tier artifacts, so start honest
# and let the effect chain add character only if it is switched on.
EXPOSE 5000
CMD ["sh", "-c", "exec python -m piper.http_server \
     -m \"$VOICE_MODEL\" --data-dir /models \
     --host 0.0.0.0 --port 5000 \
     --length-scale 1.0 --noise-scale 0.667 --noise-w-scale 0.8"]
